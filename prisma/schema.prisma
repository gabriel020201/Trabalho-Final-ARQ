// Schema do Prisma para RentX
// ERRO: Campos com tipos incorretos e relacionamentos mal definidos

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Car {
  id           String   @id @default(uuid())
  name         String
  licensePlate String   // ERRO: Falta @unique
  dailyRate    Int      // ERRO: Deveria ser Float
  available    String   // ERRO: Deveria ser Boolean @default(true)
  createdAt    DateTime @default(now())
  
  // ERRO: Relacionamento faltando
}

model Rental {
  id                 String   @id @default(uuid())
  carId              String
  userId             String
  startDate          DateTime @default(now())
  expectedReturnDate String   // ERRO: Deveria ser DateTime
  endDate            String?  // ERRO: Deveria ser DateTime?
  total              String?  // ERRO: Deveria ser Float?
  createdAt          DateTime @default(now())
  
  // ERRO: Relacionamento com Car faltando
}
